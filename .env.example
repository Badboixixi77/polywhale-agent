# PolyWhale v2 — autonomous Solana DEX trading bot
# Copy this file to .env and fill in your own values. NEVER commit .env.

# Dedicated bot wallet (base58 private key). Use a wallet holding ONLY the bankroll.
WALLET_PRIVATE_KEY=
RPC_URL=https://api.mainnet-beta.solana.com

# Paper trading until you are ready. Set to false ONLY when you understand the risks.
DRY_RUN=true

# Bankroll (USD). Scaling up later = edit these numbers only.
BANKROLL=20
MAJORS_BUDGET=10
MEME_BUDGET=10

# Majors sleeve: DCA + trend filter
DCA_AMOUNT_USD=2
DCA_INTERVAL_HOURS=168
SMA_WINDOW=20

# Meme sleeve
MEME_TRADE_CAP_USD=2
MAX_MEME_POSITIONS=5
MIN_TOKEN_LIQUIDITY_USD=5000
MIN_TOKEN_AGE_HOURS=24
TAKE_PROFIT_PCT=0.50
STOP_LOSS_PCT=-0.40
TRAILING_STOP_PCT=0.20
MAX_HOLD_HOURS=72

# Portfolio guardrails
DAILY_LOSS_LIMIT_PCT=0.05
DRAWDOWN_KILL_PCT=0.20
SLIPPAGE_BPS=100
MAX_PRIORITY_FEE_LAMPORTS=100000

# Alerts (optional). Leave empty for log-only alerts.
# Create a bot with @BotFather, then message your bot once and get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
