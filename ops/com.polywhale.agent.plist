<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polywhale.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/user/Desktop/polywhale-agent/venv/bin/python</string>
        <string>/Users/user/Desktop/polywhale-agent/src/agent.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/user/Desktop/polywhale-agent</string>

    <!-- Start at login and restart automatically if the process dies -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Wait 30s before respawning a crashing bot (no hot crash loops) -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/user/Desktop/polywhale-agent/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user/Desktop/polywhale-agent/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
